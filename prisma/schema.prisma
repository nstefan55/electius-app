// prisma/schema.prisma — Electius Database Schema v2
// PostgreSQL (Neon serverless) + Prisma ORM 7
// Connection URLs live in prisma.config.ts (migrations) and the Neon adapter (runtime) — not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── BetterAuth — required models (Prisma adapter) ─────────

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Email/password provider (BetterAuth built-in)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // List active sessions per admin
  @@index([expiresAt]) // Cleanup job for expired sessions
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier]) // OTP / magic-link lookup by email
  @@index([expiresAt]) // Cleanup job for expired verifications
  @@map("verifications")
}

// ───────── 1. Organization ─────────

enum OrganizationType {
  UNIVERSITY // university or school
  COMPANY
  UNION
  ASSOCIATION // association or club
  OTHER
}

model Organization {
  id           String            @id @default(cuid())
  name         String
  type         OrganizationType? // collected in /setup; null on pre-setup rows
  logoUrl      String?
  contactEmail String            @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  admins    User[]
  elections Election[]

  @@map("organizations")
}

// ───────── 2. Admin (BetterAuth User) + freemium / Stripe ─────────

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Freemium / billing (entitlement foundation — enforcement off during MVP)
  isPro                Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Pristupačnost — po osobi, ne po organizaciji. Čita ih requireSession(),
  // primjenjuje ih CSS preko data-atributa na ljusci.
  // ponytail: četiri stupca jer četiri booleana ne trebaju parsiranje ni zod;
  // prefs Json tek preko ~6 preferencija.
  reduceMotion  Boolean @default(false)
  highContrast  Boolean @default(false)
  largerText    Boolean @default(false)
  focusOutlines Boolean @default(true) // uključeno po dizajnu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // BetterAuth relations
  accounts Account[]
  sessions Session[]

  // Electius relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  elections      Election[]

  @@map("users")
}

// ───────── 3. Elections ─────────

enum ElectionType {
  STANDARD
  POLL
  SURVEY
}

enum VotingType {
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ResultsMode {
  AFTER_CLOSE
  LIVE // Pro only
}

model Election {
  id           String         @id @default(cuid())
  title        String
  description  String?
  electionType ElectionType   @default(STANDARD)
  votingType   VotingType     @default(SINGLE_CHOICE)
  status       ElectionStatus @default(DRAFT)
  startsAt     DateTime
  endsAt       DateTime

  // Settings (wizard step 4)
  resultsVisible      Boolean     @default(false) // results shown to voters/public at all
  resultsMode         ResultsMode @default(AFTER_CLOSE) // LIVE = Pro only
  allowAbstain        Boolean     @default(false) // abstain option — Pro only
  quorumThreshold     Int? // null = no quorum; otherwise required turnout %
  voterReminder24h    Boolean     @default(false) // email reminder 24h before close
  adminTurnoutReminder Boolean    @default(false) // email admin turnout updates during voting — Pro only
  sealedResults       Boolean     @default(false) // hide tallies from everyone (admins included) until close

  // Biljeg idempotentnosti SAMO za automatski podsjetnik (pro-features §2).
  // Postoji jer sendReminders ponovno kuje svakom primatelju čarobnu poveznicu:
  // sirovi token je nepovratan pa podsjetnik nužno ubija prethodno poslanu vezu.
  // Jednom, namjerno — ali ne na svaki otkucaj metle koja se pinga svake minute.
  // Iz stanja birača se to ne da izvesti: sendReminders ostavlja INVITED kao
  // INVITED.
  //
  // "auto" u imenu je obveza, ne ukras: ručni gumb Pošalji podsjetnik ovaj
  // stupac NITI postavlja NITI ga čita (odluka na /feature start). Da ga dijele,
  // jedno ručno podsjećanje pet dana ranije tiho bi ugasilo oglašeni automatski
  // podsjetnik — administrator bi isključio Pro značajku koristeći Pro značajku.
  autoReminderSentAt DateTime?

  // Spremljeni PDF izvještaj (election-report-storage-spec). Ključ, ne URL: URL
  // bi ukalupio host kante, pa bi svaki redak bio kriv nakon selidbe ili CDN-a.
  reportKey         String? // R2 object key u privatnoj kanti
  reportGeneratedAt DateTime?
  reportLocale      String? // "hr" | "en" — prvi render pobjeđuje (D7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  voters  Voter[]
  options VoteOption[]
  votes   Vote[]
  archive Archive?

  @@index([organizationId])
  @@index([status]) // dashboard filtering by status
  @@map("elections")
}

// ───────── 4. Voter ─────────

enum VoterStatus {
  PENDING // imported, invitation not yet sent (election in DRAFT/SCHEDULED)
  INVITED // invitation sent, awaiting vote
  VOTED // voter has voted
}

model Voter {
  id        String      @id @default(cuid())
  email     String
  firstName String?
  lastName  String?
  status    VoterStatus @default(PENDING)
  createdAt DateTime    @default(now())

  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  token VoterToken?

  @@unique([email, electionId]) // one voter, one vote per election
  @@index([electionId])
  @@map("voters")
}

// ───────── 5. Token (no updatedAt — write-once, single `used` flip) ─────────

model VoterToken {
  id        String   @id @default(cuid())
  hash      String   @unique // SHA-256(rawToken) — raw token never stored
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  voterId String @unique // 1:1 — one token per voter per election
  voter   Voter  @relation(fields: [voterId], references: [id], onDelete: Cascade)

  electionId String // denormalized for faster validation

  @@index([electionId])
  @@map("voter_tokens")
}

// ───────── 6. Vote — NO voterId / NO relation to Voter ─────────

model Vote {
  id         String   @id @default(cuid())
  voteHash   String   @unique // SHA-256(electionId + optionIds + timestamp)
  batchOrder Int // crypto.randomInt() — prevents timing correlation
  createdAt  DateTime @default(now())

  electionId String
  election   Election @relation(fields: [electionId], references: [id])

  options VoteToOption[]

  // voterId / voter relation intentionally absent — anonymity guaranteed at schema level.

  @@index([electionId])
  @@map("votes")
}

// ───────── 7. Vote option ─────────

model VoteOption {
  id          String  @id @default(cuid())
  text        String
  description String? // candidate role/description (wizard step 2, optional)
  orderIndex  Int

  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  votes VoteToOption[]

  @@index([electionId])
  @@map("vote_options")
}

// ───────── 7b. Junction table — Vote ↔ VoteOption (M:N) ─────────

model VoteToOption {
  voteId   String
  optionId String

  vote   Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([voteId, optionId])
  @@map("vote_to_options")
}

// ───────── 8. Archive — Cloudflare R2 (file + link types), retention cap ─────────

model Archive {
  id           String @id @default(cuid())
  merkleRoot   String // Merkle tree root hash (SHA-256 hex)
  proofData    Json // JSONB: {leaves, tree, root, algorithm, leafOrdering}
  electionData Json // JSONB: snapshot of election config at archival time

  // fileUrl/fileName/fileSize/url maknuti: rezervirani u shemi v2 za cjevovod
  // koji su dvije kasnije odluke zaobišle (ispis preglednika, pečat bez
  // artefakta). Izvještaj sada živi na Election (D5) — mrtva shema pokraj žive
  // poziva upravo grešku s dva doma koju D5 izbjegava.

  expiresAt DateTime? // retention cap — Free: createdAt + 1 year; Pro: null (unlimited)
  // Kad je teret dokaza obrezan. Stupac, ne ključ u proofData: metla bira
  // kandidate s `expiresAt <= now, prunedAt: null`, a negirani JSON path filtar
  // na retku bez tog ključa vraća NULL — NOT(NULL = true) je NULL, pa bi redak
  // tiho ispao i ništa se nikad ne bi obrezalo. Nadgrobni zapis u proofData i
  // dalje nosi isti datum, za onoga tko čita sam JSON.
  prunedAt  DateTime?
  createdAt DateTime  @default(now())

  electionId String   @unique
  election   Election @relation(fields: [electionId], references: [id])

  @@map("archives")
}

// ───────── 9. Subscription — @better-auth/stripe (plugin-owned) ─────────
// Izvor istine iz Stripea. users.isPro ostaje projekcija koju čita ostatak
// aplikacije — nikad se ne čita spoj u gateu.

model Subscription {
  id String @id @default(cuid())

  plan String

  // D1: drži organizationId, ne userId — pretplata se naplaćuje po organizaciji
  // i roadmap sjedala je org-scoped. NIJE unique: nakon otkazivanja korisnik se
  // mora moći ponovno pretplatiti, a to je drugi red.
  // Bez FK-a na User/Organization: plugin ovdje očekuje običan string.
  referenceId String

  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  // seats i stripeScheduleId stižu neiskorišteni — ugovor plugina, ne naš. Bez
  // njih je migracija na dan kad sjedala krenu, a to je stavka koja je odlučila arhitekturu.
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}
